generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  blocked
  deleted
  pending

  @@map("user_status")
}

enum UserRoleEnum {
  tenant
  host
  admin
  moderator
  support

  @@map("user_role")
}

enum VerificationType {
  email
  phone
  document
  address
  selfie

  @@map("verification_type")
}

enum VerificationStatus {
  pending
  verified
  rejected
  expired

  @@map("verification_status")
}

enum MediaType {
  image
  video
  document

  @@map("media_type")
}

enum MediaVisibility {
  staged
  public
  deleting

  @@map("media_visibility")
}

enum LocationPrecision {
  exact
  approx
  district
  city

  @@map("location_precision")
}

enum PropertyType {
  house
  apartment
  building
  shared_house
  other

  @@map("property_type")
}

enum ListingStatus {
  draft
  pending_review
  published
  paused
  suspended
  archived

  @@map("listing_status")
}

enum RoomStatus {
  draft
  published
  paused

  @@map("room_status")
}

enum RoomType {
  private
  shared

  @@map("room_type")
}

enum RentalUnitType {
  entire_place
  private_room
  shared_bed

  @@map("rental_unit_type")
}

enum RentalMode {
  nightly
  monthly

  @@map("rental_mode")
}

enum BathroomType {
  private
  shared
  ensuite

  @@map("bathroom_type")
}

enum BedType {
  single
  double
  bunk
  queen
  king

  @@map("bed_type")
}

enum AmenityCategory {
  room
  property
  building
  safety
  internet
  kitchen

  @@map("amenity_category")
}

enum BillingPeriod {
  monthly
  weekly
  daily

  @@map("billing_period")
}

enum AvailabilityRuleType {
  open_range
  blocked_range
  weekly_pattern

  @@map("availability_rule_type")
}

enum CalendarBlockReason {
  maintenance
  owner_block
  booked
  other

  @@map("calendar_block_reason")
}

enum SearchEntityType {
  listing
  room

  @@map("search_entity_type")
}

enum BookingStatus {
  requested
  accepted
  rejected
  cancelled
  // Retained for historical bookings; not accepted by the active status DTO.
  paid
  active
  completed
  // Retained for historical bookings; not accepted by the active status DTO.
  refunded
  disputed

  @@map("booking_status")
}

enum ParticipantRole {
  tenant
  host
  support

  @@map("participant_role")
}

enum MessageType {
  text
  system
  image
  file

  @@map("message_type")
}

enum ReportEntityType {
  user
  listing
  room
  message
  review

  @@map("report_entity_type")
}

enum ReportReason {
  scam
  spam
  harassment
  inappropriate
  other

  @@map("report_reason")
}

enum ReportStatus {
  open
  in_review
  resolved
  dismissed

  @@map("report_status")
}

enum ModerationActionType {
  warn
  suspend
  ban
  unpublish
  remove_content

  @@map("moderation_action_type")
}

enum NotificationStatus {
  queued
  sent
  failed
  read

  @@map("notification_status")
}

enum ReviewVoteType {
  helpful
  not_helpful

  @@map("review_vote_type")
}

model Country {
  code          String         @id @db.VarChar(2)
  name          String         @db.Text
  regions       Region[]
  addresses     Address[]

  @@map("countries")
}

model Region {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode String   @map("country_code") @db.VarChar(2)
  name        String   @db.Text
  ubigeoCode  String?  @map("ubigeo_code") @db.VarChar(2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  country   Country   @relation(fields: [countryCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  cities    City[]
  addresses Address[]

  @@unique([countryCode, name])
  @@unique([countryCode, ubigeoCode])
  @@map("regions")
}

model City {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId   String   @map("region_id") @db.Uuid
  name       String   @db.Text
  ubigeoCode String?  @map("ubigeo_code") @db.VarChar(4)
  centerLat  Decimal? @map("center_lat") @db.Decimal(9, 6)
  centerLng  Decimal? @map("center_lng") @db.Decimal(9, 6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  region    Region     @relation(fields: [regionId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  districts District[]
  addresses Address[]

  @@unique([regionId, name])
  @@unique([ubigeoCode])
  @@map("cities")
}

model District {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId     String   @map("city_id") @db.Uuid
  name       String   @db.Text
  ubigeoCode String?  @map("ubigeo_code") @db.VarChar(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  city      City      @relation(fields: [cityId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  addresses Address[]

  @@unique([cityId, name])
  @@unique([ubigeoCode])
  @@map("districts")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String?    @unique @db.Citext
  phoneE164    String?    @unique @map("phone_e164") @db.VarChar(20)
  passwordHash String?    @map("password_hash") @db.Text
  status       UserStatus @default(pending)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  profile                  UserProfile?
  roles                    UserRole[]
  sessions                 UserSession[]
  verifications            UserVerification[]
  ownedMedia               Media[]                   @relation("MediaOwner")
  hostedListings           Listing[]                 @relation("ListingHost")
  hostListingDrafts        HostListingDraft[]
  tenantBookings           Booking[]                 @relation("BookingTenant")
  hostBookings             Booking[]                 @relation("BookingHost")
  conversationParticipants ConversationParticipant[]
  blockedUsers             UserBlock[]                @relation("UserBlocksSent")
  blockedByUsers           UserBlock[]                @relation("UserBlocksReceived")
  sentMessages             Message[]                 @relation("MessageSender")
  reviewsWritten           Review[]                  @relation("ReviewReviewer")
  reviewsReceived          Review[]                  @relation("ReviewReviewee")
  reviewVotes              ReviewVote[]
  reportsCreated           Report[]                  @relation("ReportReporter")
  moderationActions        ModerationAction[]        @relation("ModerationActionModerator")
  notificationPreference   NotificationPreference?
  notifications            Notification[]
  favorites                Favorite[]
  searchQueries            SearchQuery[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([status], map: "idx_users_status")
  @@index([createdAt], map: "idx_users_created_at")
  @@map("users")
}

model UserProfile {
  userId      String    @id @map("user_id") @db.Uuid
  avatarMediaId String? @unique @map("avatar_media_id") @db.Uuid
  firstName   String?   @map("first_name") @db.Text
  lastName    String?   @map("last_name") @db.Text
  displayName String?   @map("display_name") @db.Text
  birthDate   DateTime? @map("birth_date") @db.Date
  gender      String?   @db.Text
  photoUrl    String?   @map("photo_url") @db.Text
  bio         String?   @db.Text
  locale      String    @default("es-PE") @db.Text
  timezone    String    @default("America/Lima") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user       User  @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  avatarMedia Media? @relation("UserAvatarMedia", fields: [avatarMediaId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  @@map("user_profiles")
}

model UserRole {
  userId    String       @map("user_id") @db.Uuid
  role      UserRoleEnum
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model UserSession {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  refreshTokenHash String  @map("refresh_token_hash") @db.Text
  userAgent        String? @map("user_agent") @db.Text
  ip               String? @db.Inet

  // New Columns from your ALTER TABLE
  deviceId            String?   @map("device_id") @db.Text
  tokenVersion        Int       @default(1) @map("token_version")
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz(6)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  // Relations
  user             User          @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  replacedBy       UserSession?  @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  replacedSessions UserSession[] @relation("SessionRotation")

  @@index([userId], map: "idx_user_sessions_user_id")
  @@index([expiresAt], map: "idx_user_sessions_expires_at")
  @@index([userId, deviceId], map: "idx_user_sessions_user_device")
  @@index([revokedAt], map: "idx_user_sessions_revoked")
  @@map("user_sessions")
}

model UserVerification {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  type       VerificationType
  status     VerificationStatus @default(pending)
  verifiedAt DateTime?          @map("verified_at") @db.Timestamptz(6)
  metadata   Json               @default("{}")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([userId], map: "idx_user_verifications_user_id")
  @@index([type, status], map: "idx_user_verifications_type_status")
  @@map("user_verifications")
}

model EmailVerificationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  email      String    @db.Citext
  tokenHash  String    @map("token_hash") @db.Text
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_email_verif_user")
  @@index([expiresAt], map: "idx_email_verif_expires")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.Text
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_user")
  @@index([expiresAt], map: "idx_password_reset_expires")
  @@map("password_reset_tokens")
}

model Media {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId     String?   @map("owner_user_id") @db.Uuid
  type            MediaType
  visibility      MediaVisibility @default(public)
  mimeType        String    @map("mime_type") @db.Text
  sizeBytes       BigInt    @map("size_bytes")
  storageProvider String    @map("storage_provider") @db.Text
  storageKey      String    @map("storage_key") @db.Text
  publicUrl       String?   @map("public_url") @db.Text
  thumbnailStorageKey String? @map("thumbnail_storage_key") @db.Text
  thumbnailPublicUrl String? @map("thumbnail_public_url") @db.Text
  thumbnailSizeBytes BigInt? @map("thumbnail_size_bytes")
  thumbnailWidth Int? @map("thumbnail_width")
  thumbnailHeight Int? @map("thumbnail_height")
  width           Int?
  height          Int?
  durationSec     Int?      @map("duration_sec")
  hashSha256      String?   @map("hash_sha256") @db.Text
  uploadKey       String?   @map("upload_key") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner              User?          @relation("MediaOwner", fields: [ownerUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  avatarProfiles     UserProfile[]  @relation("UserAvatarMedia")
  listingMedia       ListingMedia[]
  roomMedia          RoomMedia[]
  hostListingDraftPhotos HostListingDraftPhoto[]
  messageMedia       MessageMedia[]

  @@unique([storageProvider, storageKey])
  @@unique([ownerUserId, uploadKey])
  @@index([visibility, createdAt], map: "idx_media_visibility_created_at")
  @@map("media")
}

model Address {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode String            @map("country_code") @db.VarChar(2)
  regionId    String?           @map("region_id") @db.Uuid
  cityId      String?           @map("city_id") @db.Uuid
  districtId  String?           @map("district_id") @db.Uuid
  line1       String?           @db.Text
  line2       String?           @db.Text
  postalCode  String?           @map("postal_code") @db.Text
  lat         Decimal?          @db.Decimal(9, 6)
  lng         Decimal?          @db.Decimal(9, 6)
  geohash     String?           @db.Text
  precision   LocationPrecision @default(approx)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  country  Country   @relation(fields: [countryCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  region   Region?   @relation(fields: [regionId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  city     City?     @relation(fields: [cityId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  district District? @relation(fields: [districtId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  listings Listing[]

  @@index([countryCode], map: "idx_addresses_country")
  @@index([regionId], map: "idx_addresses_region")
  @@index([cityId], map: "idx_addresses_city")
  @@index([districtId], map: "idx_addresses_district")
  @@index([geohash], map: "idx_addresses_geohash")
  @@index([lat, lng], map: "idx_addresses_lat_lng")
  @@map("addresses")
}

model Listing {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostUserId          String                   @map("host_user_id") @db.Uuid
  title               String                   @db.Text
  description         String?                  @db.Text
  propertyType        PropertyType             @map("property_type")
  listingStatus       ListingStatus            @default(draft) @map("listing_status")
  addressId           String                   @map("address_id") @db.Uuid
  visibilityPrecision LocationPrecision        @default(exact) @map("visibility_precision")
  rules               Json                     @default("{}")
  minStayNights       Int?                     @map("min_stay_nights")
  maxStayNights       Int?                     @map("max_stay_nights")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt         DateTime?                @map("published_at") @db.Timestamptz(6)
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz(6)
  creationKey         String?                  @map("creation_key") @db.Uuid
  creationPayloadHash String?                  @map("creation_payload_hash") @db.Char(64)
  draftVersion        Int                      @default(1) @map("draft_version")
  searchVector        Unsupported("tsvector")? @map("search_vector")

  host          User             @relation("ListingHost", fields: [hostUserId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  address       Address          @relation(fields: [addressId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  media         ListingMedia[]
  rooms         Room[]
  amenities     ListingAmenity[]
  listingRules  ListingRule[]
  conversations Conversation[]
  publishedDraft HostListingDraft? @relation("PublishedHostListingDraft")
  legacyDraft    HostListingDraft? @relation("LegacyHostListingDraft")

  @@unique([hostUserId, creationKey])
  @@index([hostUserId, listingStatus], map: "idx_listings_host_status")
  @@index([addressId], map: "idx_listings_address_id")
  @@index([publishedAt], map: "idx_listings_published_at")
  @@index([createdAt], map: "idx_listings_created_at")
  @@map("listings")
}

model HostListingDraft {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostUserId         String   @map("host_user_id") @db.Uuid
  creationKey        String   @map("creation_key") @db.Uuid
  draftData          Json     @default("{}") @map("draft_data")
  title              String?  @db.Text
  searchText         String?  @map("search_text") @db.Text
  propertyType       PropertyType? @map("property_type")
  offerType          RentalUnitType? @map("offer_type")
  rentalMode         RentalMode? @map("rental_mode")
  currentStep        Int      @default(0) @map("current_step")
  version            Int      @default(1)
  publishedListingId String?  @unique @map("published_listing_id") @db.Uuid
  legacyListingId    String?  @unique @map("legacy_listing_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  host             User                    @relation(fields: [hostUserId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  publishedListing Listing?               @relation("PublishedHostListingDraft", fields: [publishedListingId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  legacyListing    Listing?                @relation("LegacyHostListingDraft", fields: [legacyListingId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  photos           HostListingDraftPhoto[]

  @@unique([hostUserId, creationKey])
  @@index([hostUserId, updatedAt], map: "idx_host_listing_drafts_host_updated")
  @@map("host_listing_drafts")
}

model HostListingDraftPhoto {
  hostListingDraftId String   @map("host_listing_draft_id") @db.Uuid
  mediaId            String   @map("media_id") @db.Uuid
  sortOrder          Int      @default(0) @map("sort_order")
  isCover            Boolean  @default(false) @map("is_cover")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  draft HostListingDraft @relation(fields: [hostListingDraftId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  media Media            @relation(fields: [mediaId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([hostListingDraftId, mediaId])
  @@unique([hostListingDraftId, sortOrder], map: "host_listing_draft_photos_draft_sort_order_key")
  @@map("host_listing_draft_photos")
}

model ListingMedia {
  listingId String   @map("listing_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([listingId, mediaId])
  @@unique([listingId, sortOrder], map: "listing_media_listing_sort_key")
  @@map("listing_media")
}

model Room {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId     String                   @map("listing_id") @db.Uuid
  name          String                   @db.Text
  description   String?                  @db.Text
  roomType      RoomType                 @map("room_type")
  unitType      RentalUnitType           @default(private_room) @map("unit_type")
  bathroomType  BathroomType             @map("bathroom_type")
  bathroomCount Decimal                  @default(1) @map("bathroom_count") @db.Decimal(4, 1)
  bedroomCount  Int?                     @map("bedroom_count")
  floorAreaM2   Decimal?                 @map("floor_area_m2") @db.Decimal(10, 2)
  maxOccupancy  Int                      @map("max_occupancy")
  bedCount      Int                      @map("bed_count")
  bedType       BedType?                 @map("bed_type")
  isFurnished   Boolean                  @default(false) @map("is_furnished")
  availableFrom DateTime?                @map("available_from") @db.Date
  status        RoomStatus               @default(draft)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  searchVector  Unsupported("tsvector")? @map("search_vector")

  listing           Listing            @relation(fields: [listingId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  media             RoomMedia[]
  amenities         RoomAmenity[]
  pricing           RoomPricing?
  availabilityRules AvailabilityRule[]
  calendarBlocks    CalendarBlock[]
  bookings          Booking[]
  favorites         Favorite[]
  conversations     Conversation[]
  reviews           Review[]

  @@index([listingId, status], map: "idx_rooms_listing_status")
  @@index([unitType, status], map: "idx_rooms_unit_type_status")
  @@index([availableFrom], map: "idx_rooms_available_from")
  @@map("rooms")
}

model RoomMedia {
  roomId    String   @map("room_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room  Room  @relation(fields: [roomId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([roomId, mediaId])
  @@unique([roomId, sortOrder], map: "room_media_room_sort_key")
  @@map("room_media")
}

model Amenity {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category  AmenityCategory
  code      String          @unique @db.Text
  name      String          @db.Text
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  listingLinks ListingAmenity[]
  roomLinks    RoomAmenity[]

  @@map("amenities")
}

model ListingAmenity {
  listingId String   @map("listing_id") @db.Uuid
  amenityId String   @map("amenity_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([listingId, amenityId])
  @@index([amenityId], map: "idx_listing_amenities_amenity")
  @@map("listing_amenities")
}

model RoomAmenity {
  roomId    String   @map("room_id") @db.Uuid
  amenityId String   @map("amenity_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room    Room    @relation(fields: [roomId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([roomId, amenityId])
  @@index([amenityId], map: "idx_room_amenities_amenity")
  @@map("room_amenities")
}

model HouseRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.Text
  name      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listingLinks ListingRule[]

  @@map("house_rules")
}

model ListingRule {
  listingId String   @map("listing_id") @db.Uuid
  ruleId    String   @map("rule_id") @db.Uuid
  value     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing   @relation(fields: [listingId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  rule    HouseRule @relation(fields: [ruleId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([listingId, ruleId])
  @@map("listing_rules")
}

model Currency {
  code                    String                   @id @db.VarChar(3)
  symbol                  String                   @db.Text
  roomPricing             RoomPricing[]
  bookingPricingSnapshots BookingPricingSnapshot[]

  @@map("currencies")
}

model RoomPricing {
  roomId            String        @id @map("room_id") @db.Uuid
  currencyCode      String        @map("currency_code") @db.VarChar(3)
  rentAmount        Decimal       @map("rent_amount") @db.Decimal(12, 2)
  billingPeriod     BillingPeriod @map("billing_period")
  rentalMode        RentalMode    @default(monthly) @map("rental_mode")
  minStayNights     Int?          @map("min_stay_nights")
  maxStayNights     Int?          @map("max_stay_nights")
  minTermMonths     Int?          @map("min_term_months")
  maxTermMonths     Int?          @map("max_term_months")
  depositAmount     Decimal?      @map("deposit_amount") @db.Decimal(12, 2)
  utilitiesIncluded Boolean       @default(false) @map("utilities_included")
  utilitiesDetail   Json          @default("{}") @map("utilities_detail")
  cleaningFee       Decimal?      @map("cleaning_fee") @db.Decimal(12, 2)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  room     Room     @relation(fields: [roomId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([currencyCode, rentAmount], map: "idx_room_pricing_currency_amount")
  @@index([billingPeriod], map: "idx_room_pricing_period")
  @@index([rentalMode], map: "idx_room_pricing_rental_mode")
  @@map("room_pricing")
}

model AvailabilityRule {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String               @map("room_id") @db.Uuid
  ruleType    AvailabilityRuleType @map("rule_type")
  startDate   DateTime?            @map("start_date") @db.Date
  endDate     DateTime?            @map("end_date") @db.Date
  weekPattern Json?                @map("week_pattern")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([roomId], map: "idx_availability_rules_room_id")
  @@map("availability_rules")
}

model CalendarBlock {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String              @map("room_id") @db.Uuid
  startDate DateTime            @map("start_date") @db.Date
  endDate   DateTime            @map("end_date") @db.Date
  reason    CalendarBlockReason
  bookingId String?             @map("booking_id") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  room    Room     @relation(fields: [roomId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  @@index([roomId, startDate, endDate], map: "idx_calendar_blocks_room_dates")
  @@index([bookingId], map: "idx_calendar_blocks_booking_id")
  @@map("calendar_blocks")
}

model SearchQuery {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  queryText   String?  @map("query_text") @db.Text
  filters     Json     @default("{}")
  resultCount Int      @default(0) @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User?              @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  clickEvents SearchClickEvent[]

  @@index([userId, createdAt], map: "idx_search_queries_user_created")
  @@map("search_queries")
}

model SearchClickEvent {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  searchQueryId String           @map("search_query_id") @db.Uuid
  entityType    SearchEntityType @map("entity_type")
  entityId      String           @map("entity_id") @db.Uuid
  position      Int
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  searchQuery SearchQuery @relation(fields: [searchQueryId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([searchQueryId], map: "idx_search_click_events_query_id")
  @@map("search_click_events")
}

model Booking {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId       String        @map("room_id") @db.Uuid
  tenantUserId String        @map("tenant_user_id") @db.Uuid
  hostUserId   String        @map("host_user_id") @db.Uuid
  status       BookingStatus @default(requested)
  rentalMode   RentalMode    @default(monthly) @map("rental_mode")
  termMonths   Int?          @map("term_months")
  startDate    DateTime      @map("start_date") @db.Date
  endDate      DateTime      @map("end_date") @db.Date
  guestCount   Int           @default(1) @map("guest_count")
  message      String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  room            Room                    @relation(fields: [roomId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  tenant          User                    @relation("BookingTenant", fields: [tenantUserId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  host            User                    @relation("BookingHost", fields: [hostUserId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  pricingSnapshot BookingPricingSnapshot?
  reviews         Review[]
  calendarBlocks  CalendarBlock[]

  @@index([roomId, status, startDate, endDate], map: "idx_bookings_room_status_dates")
  @@index([tenantUserId, status], map: "idx_bookings_tenant_status")
  @@index([hostUserId, status], map: "idx_bookings_host_status")
  @@index([createdAt], map: "idx_bookings_created_at")
  @@map("bookings")
}

// Captures the rental conditions on a request; it is not a payment transaction.
model BookingPricingSnapshot {
  bookingId        String     @id @map("booking_id") @db.Uuid
  currencyCode     String     @map("currency_code") @db.VarChar(3)
  rentAmount       Decimal    @map("rent_amount") @db.Decimal(12, 2)
  rentalMode       RentalMode @default(monthly) @map("rental_mode")
  billingQuantity  Int        @default(1) @map("billing_quantity")
  cleaningFee      Decimal?   @map("cleaning_fee") @db.Decimal(12, 2)
  depositAmount    Decimal?   @map("deposit_amount") @db.Decimal(12, 2)
  feesTenantAmount Decimal    @default(0) @map("fees_tenant_amount") @db.Decimal(12, 2)
  feesHostAmount   Decimal    @default(0) @map("fees_host_amount") @db.Decimal(12, 2)
  totalAmount      Decimal    @map("total_amount") @db.Decimal(12, 2)
  breakdown        Json       @default("{}")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  booking  Booking  @relation(fields: [bookingId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@map("booking_pricing_snapshot")
}

model Conversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String?  @map("listing_id") @db.Uuid
  roomId    String?  @map("room_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  listing      Listing?                  @relation(fields: [listingId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  room         Room?                     @relation(fields: [roomId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([listingId], map: "idx_conversations_listing_id")
  @@index([roomId], map: "idx_conversations_room_id")
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String          @map("conversation_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  role           ParticipantRole
  lastReadAt     DateTime?       @map("last_read_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId], map: "idx_conversation_participants_user_id")
  @@map("conversation_participants")
}

model UserBlock {
  blockerUserId String   @map("blocker_user_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("UserBlocksSent", fields: [blockerUserId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  blocked User @relation("UserBlocksReceived", fields: [blockedUserId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId], map: "idx_user_blocks_blocked_user_id")
  @@map("user_blocks")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderUserId   String      @map("sender_user_id") @db.Uuid
  type           MessageType @default(text)
  content        String?     @db.Text
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation   @relation(fields: [conversationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  sender       User           @relation("MessageSender", fields: [senderUserId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  media        MessageMedia[]

  @@index([conversationId, createdAt(sort: Desc)], map: "idx_messages_conversation_created")
  @@index([senderUserId], map: "idx_messages_sender_user_id")
  @@map("messages")
}

model MessageMedia {
  messageId String   @map("message_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([messageId, mediaId])
  @@map("message_media")
}

model Review {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  reviewerUserId String   @map("reviewer_user_id") @db.Uuid
  revieweeUserId String   @map("reviewee_user_id") @db.Uuid
  roomId         String   @map("room_id") @db.Uuid
  rating         Int
  comment        String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking  Booking      @relation(fields: [bookingId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  reviewer User         @relation("ReviewReviewer", fields: [reviewerUserId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  reviewee User         @relation("ReviewReviewee", fields: [revieweeUserId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  room     Room         @relation(fields: [roomId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  votes    ReviewVote[]

  @@unique([bookingId, reviewerUserId])
  @@index([roomId], map: "idx_reviews_room_id")
  @@index([revieweeUserId], map: "idx_reviews_reviewee_user_id")
  @@index([rating], map: "idx_reviews_rating")
  @@map("reviews")
}

model ReviewVote {
  reviewId  String         @map("review_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  vote      ReviewVoteType
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  review Review @relation(fields: [reviewId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("review_votes")
}

model Report {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterUserId String           @map("reporter_user_id") @db.Uuid
  entityType     ReportEntityType @map("entity_type")
  entityId       String           @map("entity_id") @db.Uuid
  reason         ReportReason
  details        String?          @db.Text
  status         ReportStatus     @default(open)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  reporter User @relation("ReportReporter", fields: [reporterUserId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([entityType, status], map: "idx_reports_entity_status")
  @@index([reporterUserId], map: "idx_reports_reporter_user_id")
  @@map("reports")
}

model ModerationAction {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moderatorUserId String               @map("moderator_user_id") @db.Uuid
  entityType      ReportEntityType     @map("entity_type")
  entityId        String               @map("entity_id") @db.Uuid
  action          ModerationActionType
  notes           String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  moderator User @relation("ModerationActionModerator", fields: [moderatorUserId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([entityType, entityId], map: "idx_moderation_actions_entity")
  @@map("moderation_actions")
}

model NotificationPreference {
  userId    String   @id @map("user_id") @db.Uuid
  prefs     Json     @default("{}")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("notification_preferences")
}

model Notification {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  type      String             @db.Text
  title     String             @db.Text
  body      String             @db.Text
  data      Json               @default("{}")
  status    NotificationStatus @default(queued)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime?          @map("sent_at") @db.Timestamptz(6)
  readAt    DateTime?          @map("read_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)], map: "idx_notifications_user_status_created")
  @@map("notifications")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([userId, roomId])
  @@index([roomId], map: "idx_favorites_room_id")
  @@map("favorites")
}
