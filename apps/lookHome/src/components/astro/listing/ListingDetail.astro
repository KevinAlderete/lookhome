---
import BookingCard from "@/components/islands/listing/BookingCard";
import FavoriteButton from "@/components/islands/favorites/FavoriteButton";
import ListingGallery from "@/components/islands/listing/ListingGallery";
import ListingLocationMap from "@/components/islands/listing/ListingLocationMap";
import ReviewCard from "@/components/astro/ReviewCard.astro";
import ReviewStars from "@/components/astro/ReviewStars.astro";
import { apiServer } from "@/lib/api/server";
import { getMyFavorites } from "@/features/favorites/api/server";
import { resolveListingReturnTarget } from "@/features/listings/return-path";
import {
  amountLabel,
  dateLabel,
  minimumDateInPeru,
  offerTypeLabel,
  priceLabel,
  type PublicListing,
  type PublicOffer,
  type PublicReviewPage,
} from "@/features/listings/public";

interface Props {
  listing: PublicListing;
  selectedOffer?: PublicOffer;
}

const { listing, selectedOffer } = Astro.props;
const offer = selectedOffer ?? (!listing.legacyMultipleOffers && listing.offers.length === 1 ? listing.offers[0] : null);
const isLegacyOverview = !selectedOffer && listing.legacyMultipleOffers;
const galleryPhotos = selectedOffer?.photos.length
  ? selectedOffer.photos
  : listing.photos.length
    ? listing.photos
    : isLegacyOverview ? [] : (offer?.photos ?? []);
const isOwner = Boolean(Astro.locals.user?.id && Astro.locals.user.id === listing.host?.id);
const contactContext = `/mensajes?contact=1&listingId=${encodeURIComponent(listing.id)}${offer ? `&roomId=${encodeURIComponent(offer.id)}` : ""}`;
const contactReturnUrl = new URL(Astro.url);
contactReturnUrl.searchParams.set("contact", "1");
contactReturnUrl.hash = "anfitrion";
const returnPath = `${contactReturnUrl.pathname}${contactReturnUrl.search}${contactReturnUrl.hash}`;
const contactHref = Astro.locals.user ? contactContext : `/login?redirect=${encodeURIComponent(returnPath)}`;
const returnTarget = resolveListingReturnTarget(
  Astro.url.searchParams.get("returnTo"),
  Astro.url.origin,
);
const parentListingUrl = new URL(
  `/listings/${encodeURIComponent(listing.id)}`,
  Astro.url.origin,
);
parentListingUrl.searchParams.set("returnTo", returnTarget.href);
const parentListingHref = `${parentListingUrl.pathname}${parentListingUrl.search}`;
const addressLabel = [listing.address.line1, listing.address.district, listing.address.city, listing.address.region].filter(Boolean).join(", ");
const coords = listing.address.lat != null && listing.address.lng != null
  ? { lat: listing.address.lat, lng: listing.address.lng }
  : null;
const mapHref = coords
  ? `https://www.openstreetmap.org/?mlat=${coords.lat}&mlon=${coords.lng}#map=16/${coords.lat}/${coords.lng}`
  : null;
const amenities = [...new Set([...(offer?.amenities ?? []), ...listing.amenities])];
const ruleLabels = [
  listing.rules.petsAllowed == null ? null : listing.rules.petsAllowed ? "Acepta mascotas" : "No acepta mascotas",
  listing.rules.smokingAllowed == null ? null : listing.rules.smokingAllowed ? "Permite fumar" : "No permite fumar",
  listing.rules.partiesAllowed == null ? null : listing.rules.partiesAllowed ? "Permite fiestas" : "No permite fiestas",
].filter((item): item is string => Boolean(item));
const offerFeatures = offer ? [
  offer.maxGuests != null ? `Capacidad para ${offer.maxGuests} ${offer.maxGuests === 1 ? "persona" : "personas"}` : null,
  offer.bedrooms != null ? `${offer.bedrooms} ${offer.bedrooms === 1 ? "dormitorio" : "dormitorios"}` : null,
  offer.beds != null ? `${offer.beds} ${offer.beds === 1 ? "cama" : "camas"}` : null,
  offer.bathrooms != null ? `${offer.bathrooms} ${offer.bathrooms === 1 ? "baño" : "baños"}` : null,
  offer.areaM2 != null ? `${offer.areaM2} m²` : null,
  offer.isFurnished ? "Amoblado" : "Sin amoblar",
].filter((item): item is string => Boolean(item)) : [];

const reviewPageParam = Number(Astro.url.searchParams.get("reviewsPage") ?? 1);
const reviewPageNumber = Number.isSafeInteger(reviewPageParam) && reviewPageParam > 0 && reviewPageParam <= 1000 ? reviewPageParam : 1;

async function loadReviews(): Promise<{
  page: PublicReviewPage | null;
  error: boolean;
}> {
  if (!offer) return { page: null, error: false };
  try {
    return {
      page: await apiServer<PublicReviewPage>(
        Astro.request,
        `/reviews/room/${encodeURIComponent(offer.id)}`,
        { query: { page: reviewPageNumber, pageSize: 6 } },
      ),
      error: false,
    };
  } catch {
    return { page: null, error: true };
  }
}

async function loadSavedOfferIds(): Promise<{
  roomIds: Set<string>;
  error: boolean;
}> {
  if (!Astro.locals.user || isOwner)
    return { roomIds: new Set(), error: false };
  try {
    const favorites = await getMyFavorites(Astro.request);
    return {
      roomIds: new Set(favorites.map((favorite) => favorite.roomId)),
      error: false,
    };
  } catch {
    return { roomIds: new Set(), error: true };
  }
}

const [reviewResult, favoriteResult] = await Promise.all([
  loadReviews(),
  loadSavedOfferIds(),
]);
const reviews = reviewResult.page;
const reviewsError = reviewResult.error;
const savedOfferIds = favoriteResult.roomIds;
const favoritesError = favoriteResult.error;
const averageRatingLabel = reviews?.averageRating != null
  ? new Intl.NumberFormat("es-PE", { maximumFractionDigits: 1 }).format(reviews.averageRating)
  : null;
const ratingLabel = reviews?.total && averageRatingLabel
  ? `${averageRatingLabel} de 5 · ${reviews.total} ${reviews.total === 1 ? "reseña" : "reseñas"}`
  : null;
const reviewHref = (page: number) => {
  const url = new URL(Astro.url);
  url.searchParams.set("reviewsPage", String(page));
  return `${url.pathname}${url.search}#resenas`;
};
const title = selectedOffer && listing.legacyMultipleOffers
  ? `${selectedOffer.name} en ${listing.title}`
  : listing.title;
---

<article class="mx-auto max-w-[1280px] space-y-8 px-4 pb-16 pt-6 text-warm-gray sm:px-6 lg:pt-8">
    <nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-2 text-sm text-warm-gray/75">
      <a href={returnTarget.href} class="rounded-md underline-offset-4 hover:text-terracotta-strong hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">{returnTarget.label}</a>
      <span aria-hidden="true">/</span>
      {selectedOffer ? (
        <>
          <a href={parentListingHref} class="rounded-md underline-offset-4 hover:text-terracotta-strong hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">{listing.title}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{selectedOffer.name}</span>
        </>
      ) : <span aria-current="page">{listing.title}</span>}
    </nav>

    <header class="space-y-4">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-3">
          {isLegacyOverview ? (
            <p class="inline-flex rounded-full bg-terracotta/10 px-3 py-1.5 text-sm font-semibold text-terracotta-strong">
              Varias ofertas independientes
            </p>
          ) : offer ? (
            <p class="inline-flex flex-wrap items-center gap-2 text-sm font-semibold text-terracotta-strong">
              <span>{offerTypeLabel(offer.offerType)}</span>
              {offer.pricing && (
                <span class="rounded-full bg-terracotta/10 px-3 py-1.5">
                  {offer.pricing.rentalMode === "monthly" ? "Por mes" : "Por día"}
                </span>
              )}
            </p>
          ) : null}
          <h1 class="max-w-4xl break-words text-3xl font-bold leading-tight text-warm-gray sm:text-4xl lg:text-5xl">
            {title}
          </h1>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            {addressLabel && (
              <p class="break-words text-sm text-warm-gray/75 sm:text-base">
                {addressLabel}
              </p>
            )}
            {ratingLabel && (
              <a
                href="#resenas"
                class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-warm-gray/12 bg-white px-3 py-2 text-sm font-semibold text-warm-gray underline-offset-4 hover:border-terracotta/40 hover:text-terracotta-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong"
                aria-label={`Ver reseñas: ${ratingLabel}`}
              >
                <ReviewStars
                  id={`offer-rating-${offer?.id ?? listing.id}`}
                  rating={reviews?.averageRating ?? 0}
                  label={ratingLabel}
                />
                <span>{averageRatingLabel} / 5</span>
                <span class="text-warm-gray/65">
                  · {reviews?.total} {reviews?.total === 1 ? "reseña" : "reseñas"}
                </span>
              </a>
            )}
          </div>
          {offerFeatures.length > 0 && (
            <ul
              aria-label="Características principales"
              class="flex flex-wrap gap-2 text-sm"
            >
              {offerFeatures.map((feature) => (
                <li class="rounded-full bg-white px-3 py-2 font-semibold text-warm-gray">
                  {feature}
                </li>
              ))}
            </ul>
          )}
          {favoritesError && (
            <p role="status" class="text-sm text-warm-gray/70">
              No pudimos comprobar si guardaste esta oferta.
            </p>
          )}
        </div>
        <div class="flex shrink-0 items-center gap-2">
          {!isOwner && offer && !favoritesError && (
                <FavoriteButton
                  client:visible
                  roomId={offer.id}
                  initialIsFavorite={savedOfferIds.has(offer.id)}
                  isAuthenticated={Boolean(Astro.locals.user)}
                  accessibilityContext={`oferta ${offer.name}`}
                  size="md"
                  showError
                />
          )}
          {!isOwner && offer?.pricing && (
            <a
              href="#solicitud"
              class="inline-flex min-h-11 items-center rounded-xl bg-terracotta-strong px-4 text-sm font-semibold text-white hover:bg-warm-gray focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong"
            >
              Ver solicitud
            </a>
          )}
        </div>
      </div>
    </header>

    <section id="fotos" aria-label="Fotografías" class="scroll-mt-6">
      <ListingGallery client:load photos={galleryPhotos} title={title} />
    </section>

    <nav aria-label="Secciones del anuncio" class="flex gap-2 overflow-x-auto border-b border-warm-gray/15 pb-2 text-sm font-semibold">
      {[
        { id: "descripcion", text: "Descripción" },
        ...(isLegacyOverview ? [{ id: "ofertas", text: "Ofertas" }] : []),
        ...(amenities.length ? [{ id: "comodidades", text: "Comodidades" }] : []),
        ...(ruleLabels.length || listing.rules.notes ? [{ id: "reglas", text: "Reglas" }] : []),
        { id: "ubicacion", text: "Ubicación" },
        ...(offer ? [{ id: "resenas", text: "Reseñas" }] : []),
        ...(listing.host ? [{ id: "anfitrion", text: "Anfitrión" }] : []),
      ].map((section) => <a href={`#${section.id}`} class="inline-flex min-h-11 shrink-0 items-center rounded-xl px-3 text-warm-gray/75 hover:bg-white hover:text-warm-gray focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">{section.text}</a>)}
    </nav>

    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(290px,350px)]">
      <aside class="min-w-0 space-y-4 lg:sticky lg:top-6 lg:col-start-2 lg:row-start-1" aria-label="Precio y solicitud">
        {isLegacyOverview ? <div class="rounded-3xl bg-white p-6 shadow-[0_12px_36px_rgba(80,76,74,0.07)]"><h2 class="text-xl font-bold">Elige una oferta</h2><p class="mt-2 text-sm leading-6 text-warm-gray/75">Cada oferta antigua conserva su precio, modalidad y condiciones. Abre la que te interesa para solicitar o consultar.</p><a href="#ofertas" class="mt-4 inline-flex min-h-11 items-center font-semibold text-terracotta-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">Ver ofertas disponibles</a></div> : offer ? (
          <>
            {isOwner ? <div class="rounded-3xl bg-white p-6"><h2 class="text-xl font-bold">Tu anuncio</h2><p class="mt-2 text-sm text-warm-gray/75">Puedes revisar su presentación pública. Las solicitudes se envían desde otras cuentas.</p><a href={`/host/anuncios/${encodeURIComponent(listing.id)}/editar`} class="mt-4 inline-flex min-h-11 items-center font-semibold text-terracotta-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">Gestionar anuncio</a></div> : offer.pricing ? (
              <BookingCard client:load resourceId={offer.id} price={offer.pricing.rentAmount} rentalMode={offer.pricing.rentalMode} currencyCode={offer.pricing.currencyCode} maxGuests={offer.maxGuests} depositAmount={offer.pricing.depositAmount} cleaningFee={offer.pricing.cleaningFee} minStayNights={offer.pricing.minStayNights} maxStayNights={offer.pricing.maxStayNights} minTermMonths={offer.pricing.minTermMonths} maxTermMonths={offer.pricing.maxTermMonths} minimumDate={minimumDateInPeru()} isAuthenticated={Boolean(Astro.locals.user)} returnPath={Astro.url.pathname} />
            ) : <div class="rounded-3xl bg-white p-6"><h2 class="text-xl font-bold">Solicitud no disponible</h2><p class="mt-2 text-sm leading-6 text-warm-gray/75">La oferta no tiene una modalidad y un precio claros. Consulta sus condiciones antes de solicitar.</p></div>}
            {offer.pricing && <div class="rounded-2xl border border-warm-gray/12 bg-white p-5 text-sm leading-6 text-warm-gray/75">
              <h2 class="font-bold text-warm-gray">Condiciones de la oferta</h2>
              <p class="mt-2 font-semibold text-warm-gray">{priceLabel(offer)}</p>
              {offer.pricing.rentalMode === "monthly" ? <><p>Depósito: {offer.pricing.depositAmount == null ? "Por confirmar" : amountLabel(offer.pricing.depositAmount, offer.pricing.currencyCode)}</p><p>Duración: mínimo {offer.pricing.minTermMonths ?? 1} {offer.pricing.minTermMonths === 1 ? "mes" : "meses"}{offer.pricing.maxTermMonths != null ? `, máximo ${offer.pricing.maxTermMonths} meses` : ""}.</p></> : <><p>Estadía: mínimo {offer.pricing.minStayNights ?? 1} {offer.pricing.minStayNights === 1 ? "noche" : "noches"}{offer.pricing.maxStayNights != null ? `, máximo ${offer.pricing.maxStayNights} noches` : ""}.</p>{offer.pricing.cleaningFee != null && offer.pricing.cleaningFee > 0 && <p>Limpieza: {amountLabel(offer.pricing.cleaningFee, offer.pricing.currencyCode)}</p>}</>}
              {offer.availableFrom && <p>Disponible desde: {dateLabel(offer.availableFrom)}</p>}
              <p class="mt-2">La disponibilidad exacta se comprueba al enviar la solicitud. El anfitrión debe aprobarla.</p>
            </div>}
            {!isOwner && <div class="rounded-2xl border border-warm-gray/12 bg-white p-5 text-sm">
              <h2 class="text-lg font-bold text-warm-gray">¿Tienes una pregunta?</h2>
              <p class="mt-2 leading-6 text-warm-gray/75">Escribe al anfitrión sobre esta oferta. Conversar no envía una solicitud.</p>
              <a href={contactHref} class="mt-4 inline-flex min-h-11 items-center rounded-xl border border-terracotta-strong px-4 font-semibold text-terracotta-strong hover:bg-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">{Astro.locals.user ? "Consultar al anfitrión" : "Iniciar sesión para consultar"}</a>
            </div>}
          </>
        ) : null}
      </aside>

      <div class="min-w-0 space-y-10 lg:col-start-1 lg:row-start-1">
        <section id="descripcion" class="scroll-mt-6 space-y-3 border-b border-warm-gray/12 pb-8">
          <h2 class="text-2xl font-bold">Sobre este alojamiento</h2>
          <p class="whitespace-pre-line break-words leading-7 text-warm-gray/80">{listing.description || "El anfitrión aún no agregó una descripción."}</p>
          {offer?.description && offer.description !== listing.description && <p class="whitespace-pre-line break-words leading-7 text-warm-gray/80">{offer.description}</p>}
        </section>

        {isLegacyOverview && <section id="ofertas" class="scroll-mt-6 space-y-4 border-b border-warm-gray/12 pb-8">
          <h2 class="text-2xl font-bold">Ofertas de este anuncio</h2>
          <p class="max-w-2xl text-sm leading-6 text-warm-gray/75">Este anuncio conserva varias ofertas independientes. Revisa el precio, las condiciones y las reseñas de cada una antes de solicitar.</p>
          <div class="grid gap-4 sm:grid-cols-2">
            {listing.offers.map((item) => <article class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-warm-gray/12 bg-white shadow-sm">
              <img src={item.photos[0]?.url || "/property-placeholder.svg"} alt={item.photos[0] ? `Foto de ${item.name}` : ""} width="640" height="420" loading="lazy" class="aspect-[16/10] w-full bg-cream object-cover" />
              <div class="flex flex-1 flex-col gap-3 p-5">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-cream px-3 py-1 text-xs font-semibold text-warm-gray">{offerTypeLabel(item.offerType)}</span>
                    {item.pricing?.rentalMode && <span class="rounded-full bg-terracotta/10 px-3 py-1 text-xs font-semibold text-terracotta-strong">{item.pricing.rentalMode === "monthly" ? "Por mes" : "Por día"}</span>}
                  </div>
                  {!isOwner && !favoritesError && (
                    <FavoriteButton
                      client:visible
                      roomId={item.id}
                      initialIsFavorite={savedOfferIds.has(item.id)}
                      isAuthenticated={Boolean(Astro.locals.user)}
                      accessibilityContext={`oferta ${item.name}`}
                      size="sm"
                      showError
                    />
                  )}
                </div>
                <h3 class="break-words text-lg font-bold">{item.name}</h3>
                <p class="text-lg font-bold text-warm-gray">{priceLabel(item) ?? "Precio y modalidad por confirmar"}</p>
                <ul aria-label={`Características de ${item.name}`} class="flex flex-wrap gap-2 text-xs text-warm-gray/75">
                  {item.maxGuests != null && <li class="rounded-full bg-cream px-3 py-1.5">Capacidad para {item.maxGuests} {item.maxGuests === 1 ? "persona" : "personas"}</li>}
                  {item.beds != null && <li class="rounded-full bg-cream px-3 py-1.5">{item.beds} {item.beds === 1 ? "cama" : "camas"}</li>}
                  {item.bathrooms != null && <li class="rounded-full bg-cream px-3 py-1.5">{item.bathrooms} {item.bathrooms === 1 ? "baño" : "baños"}</li>}
                  {item.areaM2 != null && <li class="rounded-full bg-cream px-3 py-1.5">{item.areaM2} m²</li>}
                </ul>
                <div class="space-y-1 text-sm text-warm-gray/75">
                  {item.pricing?.rentalMode === "monthly" && <>
                    <p>Depósito: {item.pricing.depositAmount == null ? "Por confirmar" : amountLabel(item.pricing.depositAmount, item.pricing.currencyCode)}</p>
                    <p>Plazo: mínimo {item.pricing.minTermMonths ?? 1} {item.pricing.minTermMonths === 1 ? "mes" : "meses"}{item.pricing.maxTermMonths != null ? ` · máximo ${item.pricing.maxTermMonths} ${item.pricing.maxTermMonths === 1 ? "mes" : "meses"}` : ""}</p>
                    {item.availableFrom && <p>Disponible desde: {dateLabel(item.availableFrom)}</p>}
                  </>}
                  {item.pricing?.rentalMode === "nightly" && <>
                    <p>Estadía: mínimo {item.pricing.minStayNights ?? 1} {item.pricing.minStayNights === 1 ? "noche" : "noches"}{item.pricing.maxStayNights != null ? ` · máximo ${item.pricing.maxStayNights} ${item.pricing.maxStayNights === 1 ? "noche" : "noches"}` : ""}</p>
                    {item.pricing.cleaningFee != null && item.pricing.cleaningFee > 0 && <p>Limpieza: {amountLabel(item.pricing.cleaningFee, item.pricing.currencyCode)}</p>}
                  </>}
                </div>
                <a href={`/habitaciones/${encodeURIComponent(item.id)}`} class="mt-auto inline-flex min-h-11 items-center justify-center rounded-xl bg-terracotta-strong px-4 font-semibold text-white hover:bg-warm-gray focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">Ver esta oferta</a>
              </div>
            </article>)}
          </div>
        </section>}

        {amenities.length > 0 && <section id="comodidades" class="scroll-mt-6 space-y-4 border-b border-warm-gray/12 pb-8">
          <h2 class="text-2xl font-bold">Comodidades</h2>
          <ul class="grid gap-2 text-sm sm:grid-cols-2">{amenities.map((name) => <li class="rounded-xl bg-white px-4 py-3 font-semibold">{name}</li>)}</ul>
        </section>}

        {(ruleLabels.length > 0 || listing.rules.notes) && <section id="reglas" class="scroll-mt-6 space-y-4 border-b border-warm-gray/12 pb-8">
          <h2 class="text-2xl font-bold">Reglas del alojamiento</h2>
          {ruleLabels.length > 0 && <ul class="grid gap-2 text-sm sm:grid-cols-2">{ruleLabels.map((rule) => <li class="rounded-xl bg-white px-4 py-3">{rule}</li>)}</ul>}
          {listing.rules.notes && <p class="whitespace-pre-line break-words text-sm leading-6 text-warm-gray/80">{listing.rules.notes}</p>}
        </section>}

        <section id="ubicacion" class="scroll-mt-6 border-b border-warm-gray/12 pb-8">
          <h2 class="text-2xl font-bold">Ubicación</h2>
          <p class="mt-2 break-words text-sm leading-6 text-warm-gray/80">{addressLabel || "Ubicación no disponible."}</p>
          {coords && <ListingLocationMap client:visible lat={coords.lat} lng={coords.lng} title={title} />}
          {mapHref && <a href={mapHref} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-terracotta-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">Ver ubicación exacta en OpenStreetMap <span class="sr-only">(se abre en otra pestaña)</span></a>}
        </section>

        {offer && (
          <section
            id="resenas"
            class="scroll-mt-6 space-y-6 border-b border-warm-gray/12 pb-8"
            aria-labelledby="reviews-title"
          >
            <header class="max-w-2xl">
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-terracotta-strong">
                Experiencias de huéspedes
              </p>
              <h2 id="reviews-title" class="mt-1 text-2xl font-bold sm:text-3xl">
                Reseñas sobre esta oferta
              </h2>
              <p class="mt-2 text-sm leading-6 text-warm-gray/75">
                Opiniones compartidas por huéspedes que enviaron una solicitud
                para esta oferta.
              </p>
            </header>

            {reviews && reviews.total > 0 && reviews.averageRating != null && (
              <div class="flex flex-col gap-4 rounded-3xl border border-warm-gray/10 bg-white p-5 shadow-[0_8px_24px_rgba(80,76,74,0.04)] sm:flex-row sm:items-center sm:justify-between sm:p-6">
                <div class="flex items-center gap-4">
                  <div
                    aria-hidden="true"
                    class="grid size-16 shrink-0 place-content-center rounded-2xl bg-cream text-center sm:size-20"
                  >
                    <span class="text-2xl font-bold leading-none text-warm-gray sm:text-3xl">
                      {averageRatingLabel}
                    </span>
                    <span class="mt-1 text-xs font-semibold text-warm-gray/65">
                      de 5
                    </span>
                  </div>
                  <div class="space-y-1">
                    <ReviewStars
                      id={`reviews-summary-${offer.id}`}
                      rating={reviews.averageRating}
                      label={`${averageRatingLabel} de 5 estrellas`}
                      size="md"
                    />
                    <p class="text-sm font-semibold text-warm-gray">
                      {reviews.total} {reviews.total === 1 ? "reseña" : "reseñas"}
                    </p>
                  </div>
                </div>
                <p class="max-w-sm text-sm leading-6 text-warm-gray/70 sm:text-right">
                  Promedio de las reseñas compartidas sobre esta oferta.
                </p>
              </div>
            )}

            {reviewsError ? (
              <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
                <p role="alert" aria-live="assertive">
                  No pudimos cargar las reseñas.
                </p>
                <a
                  href={reviewHref(reviewPageNumber)}
                  class="inline-flex min-h-11 items-center font-semibold underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2"
                >
                  Reintentar
                </a>
              </div>
            ) : reviews?.items.length ? (
              <>
                <ol aria-label="Reseñas sobre esta oferta" class="grid gap-4">
                  {reviews.items.map((review) => (
                    <li>
                      <ReviewCard review={review} />
                    </li>
                  ))}
                </ol>
                {reviews.totalPages > 1 && (
                  <div class="flex flex-col gap-3 border-t border-warm-gray/10 pt-4 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm text-warm-gray/70">
                      Mostrando {(reviews.page - 1) * reviews.pageSize + 1}–
                      {Math.min(reviews.page * reviews.pageSize, reviews.total)}
                      {" de "}
                      {reviews.total} reseñas · Página {reviews.page} de{" "}
                      {reviews.totalPages}
                    </p>
                    <nav
                      aria-label="Páginas de reseñas"
                      class="flex flex-wrap items-center gap-2"
                    >
                      {reviews.page > 1 && (
                        <a
                          href={reviewHref(reviews.page - 1)}
                          rel="prev"
                          class="inline-flex min-h-11 items-center rounded-xl border border-warm-gray/15 px-4 text-sm font-semibold hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong"
                        >
                          Anterior
                        </a>
                      )}
                      {reviews.page < reviews.totalPages && (
                        <a
                          href={reviewHref(reviews.page + 1)}
                          rel="next"
                          class="inline-flex min-h-11 items-center rounded-xl border border-warm-gray/15 px-4 text-sm font-semibold hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong"
                        >
                          Siguiente
                        </a>
                      )}
                    </nav>
                  </div>
                )}
              </>
            ) : (
              <div class="rounded-2xl border border-dashed border-warm-gray/20 bg-white p-6">
                <h3 class="font-bold text-warm-gray">
                  {reviews && reviews.total > 0
                    ? "No hay reseñas en esta página"
                    : "Esta oferta todavía no tiene reseñas"}
                </h3>
                <p class="mt-1 text-sm leading-6 text-warm-gray/75">
                  {reviews && reviews.total > 0
                    ? "Vuelve a la primera página para ver las reseñas disponibles."
                    : "Cuando un huésped comparta una reseña sobre esta oferta, aparecerá aquí."}
                </p>
                {reviews && reviews.total > 0 && (
                  <a
                    href={reviewHref(1)}
                    class="mt-3 inline-flex min-h-11 items-center font-semibold text-terracotta-strong underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong"
                  >
                    Ver la primera página
                  </a>
                )}
              </div>
            )}
          </section>
        )}

        {listing.host && <section id="anfitrion" class="scroll-mt-6 space-y-4">
          <h2 class="text-2xl font-bold">Anfitrión</h2>
          <div class="flex flex-wrap items-center gap-4 rounded-2xl bg-white p-5">
            <img src={listing.host.image || "/avatar-placeholder.png"} alt="" width="64" height="64" loading="lazy" class="h-16 w-16 rounded-full object-cover" />
            <div class="min-w-0 flex-1"><p class="break-words font-bold">{listing.host.name}</p><a href={`/anfitriones/${encodeURIComponent(listing.host.id)}`} class="mt-1 inline-flex min-h-11 items-center text-sm font-semibold text-terracotta-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">Ver perfil público</a></div>
          </div>
          {isOwner ? <p class="text-sm text-warm-gray/75">Este es tu anuncio.</p> : isLegacyOverview ? <p class="text-sm text-warm-gray/75">Elige una oferta para consultar por esa unidad.</p> : <p class="text-sm text-warm-gray/75">¿Tienes una pregunta? Usa la opción de consulta junto al precio y las condiciones de esta oferta.</p>}
        </section>}
      </div>

    </div>
  </article>
