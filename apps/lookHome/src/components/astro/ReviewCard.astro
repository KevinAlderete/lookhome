---
import ReviewStars from "./ReviewStars.astro";
import type { PublicReviewPage } from "@/features/listings/public";

interface Props {
  review: PublicReviewPage["items"][number];
}

const { review } = Astro.props;
const date = new Date(review.createdAt);
const dateText = Number.isNaN(date.getTime())
  ? ""
  : date.toLocaleDateString("es-PE", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "America/Lima",
    });
---

<article class="h-full rounded-3xl border border-warm-gray/10 bg-white p-5 shadow-[0_8px_24px_rgba(80,76,74,0.04)] sm:p-6">
  <header class="flex flex-wrap items-start gap-3">
    <img
      src={review.authorPhotoUrl || "/avatar-placeholder.png"}
      alt=""
      width="44"
      height="44"
      loading="lazy"
      class="size-11 shrink-0 rounded-full object-cover"
    />
    <div class="min-w-0 flex-1">
      <p class="break-words font-semibold text-warm-gray">{review.authorName}</p>
      {dateText && (
        <time
          dateTime={review.createdAt}
          class="mt-0.5 block text-xs text-warm-gray/70"
        >
          {dateText}
        </time>
      )}
    </div>
    <div class="ml-auto inline-flex items-center gap-2 rounded-xl bg-cream px-3 py-2">
      <ReviewStars
        id={review.id}
        rating={review.rating}
        label={`${review.rating} de 5 estrellas`}
      />
      <span aria-hidden="true" class="text-sm font-bold text-warm-gray">
        {review.rating}/5
      </span>
    </div>
  </header>
  <div class="mt-4 border-t border-warm-gray/10 pt-4">
    {review.comment ? (
      review.comment.length > 360 ? (
        <details class="group">
          <summary class="min-h-11 cursor-pointer list-none rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">
            <p class="line-clamp-4 whitespace-pre-line break-words text-sm leading-6 text-warm-gray/80 group-open:hidden">
              {review.comment}
            </p>
            <span class="mt-2 inline-flex text-xs font-bold text-terracotta-strong group-open:hidden">
              Leer reseña completa
            </span>
            <span class="hidden min-h-11 items-center text-xs font-bold text-terracotta-strong group-open:inline-flex">
              Ocultar reseña
            </span>
          </summary>
          <p class="mt-2 whitespace-pre-line break-words text-sm leading-6 text-warm-gray/80">
            {review.comment}
          </p>
        </details>
      ) : (
        <p class="whitespace-pre-line break-words text-sm leading-6 text-warm-gray/80">
          {review.comment}
        </p>
      )
    ) : (
      <p class="text-sm italic text-warm-gray/65">
        Se compartió una puntuación, sin comentario escrito.
      </p>
    )}
  </div>
</article>
