---
import FavoriteButton from "@/components/islands/favorites/FavoriteButton";
import type { SearchResultItem } from "@/features/search/types";

interface Props {
  item: SearchResultItem;
  isAuthenticated?: boolean;
  priority?: boolean;
  variant?: "search" | "featured";
  showFavorite?: boolean;
  returnTo?: string;
}

const {
  item,
  isAuthenticated = false,
  priority = false,
  variant = "search",
  showFavorite = true,
  returnTo = "/buscar",
} = Astro.props;
const isFeatured = variant === "featured";
const unitLabel =
  item.unitType === "entire_place"
    ? "Vivienda completa"
    : item.unitType === "private_room"
      ? "Habitación privada"
      : item.unitType === "shared_bed"
        ? "Cama compartida"
        : null;
const accommodationLabel =
  item.accommodationType === "house"
    ? "Casa"
    : item.accommodationType === "apartment"
      ? "Departamento"
      : item.accommodationType === "room"
        ? "Cuarto/habitación"
        : null;
const imageBadgeLabel = item.legacyMultipleOffers
  ? "Varias ofertas"
  : unitLabel || accommodationLabel;
const propertyLabel =
  item.accommodationType === "house"
    ? "Casa"
    : item.accommodationType === "apartment"
      ? "Departamento"
      : null;
const priceSummaryLabel = item.priceLabel ??
  (item.legacyMultipleOffers
    ? "Varias ofertas para comparar"
    : item.rentalMode
      ? `Modalidad por ${item.rentalMode === "monthly" ? "mes" : "día"}; precio por confirmar`
      : "Precio y modalidad por confirmar");
const cardAriaLabel = [
  `Ver anuncio: ${item.title}`,
  imageBadgeLabel,
  priceSummaryLabel,
  item.addressLabel,
]
  .filter(Boolean)
  .join(". ");
const legacyFavoriteSummary =
  item.favoriteOffers?.length === 1
    ? "Guardar la oferta publicada"
    : `Guardar una de ${item.favoriteOffers?.length ?? 0} ofertas`;
const imageUrl = item.imageUrl || "/property-placeholder.svg";
const detailUrl = new URL(item.href, Astro.url);
detailUrl.searchParams.set("returnTo", returnTo);
const detailHref = `${detailUrl.pathname}${detailUrl.search}${detailUrl.hash}`;
const articleClass = isFeatured
  ? "listing-card group relative overflow-hidden rounded-2xl border border-warm-gray/12 bg-white transition focus-within:border-terracotta-strong"
  : "listing-card group relative overflow-hidden rounded-2xl border border-warm-gray/15 bg-white transition focus-within:border-terracotta-strong";
---

<article
  class={articleClass}
  data-listing-id={item.id}
>
  <a
    href={detailHref}
    class="block focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-terracotta"
    aria-label={cardAriaLabel}
  >
    <div class="relative aspect-[16/10] overflow-hidden bg-cream">
      <img
        src={imageUrl}
        alt=""
        width="640"
        height="420"
        class="h-full w-full object-cover"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
        data-property-image
      />
      {!isFeatured && <div class="absolute inset-0 bg-gradient-to-t from-[#302b29]/35 via-transparent to-transparent" aria-hidden="true"></div>}
      {imageBadgeLabel && (
        isFeatured ? (
          <span class="absolute left-3 top-3 rounded-full bg-white/95 px-3 py-1.5 text-xs font-bold text-warm-gray shadow-sm">
            {imageBadgeLabel}
          </span>
        ) : (
          <span class="absolute left-2.5 top-2.5 rounded-full bg-cream px-3 py-1.5 text-xs font-semibold text-warm-gray shadow-sm">
            {imageBadgeLabel}
          </span>
        )
      )}
      {item.priceLabel && (
        isFeatured ? (
          <span class="absolute bottom-3 left-3 rounded-lg bg-warm-gray/90 px-3 py-1.5 text-sm font-bold text-white shadow-sm">
            {item.priceLabel}
          </span>
        ) : (
          <span class="absolute bottom-3 left-3 max-w-[calc(100%-1.5rem)] rounded-lg bg-terracotta-strong px-3 py-2 text-sm font-semibold leading-tight text-white shadow-sm sm:text-base">
            {item.priceLabel}
          </span>
        )
      )}
    </div>

    <div class:list={["min-w-0", isFeatured ? "px-4 py-4" : "px-3 py-3"]}>
      <h3 class:list={["line-clamp-2 pr-8 font-bold leading-snug text-warm-gray", isFeatured ? "text-base" : "text-[0.95rem]"]}>
        {item.title}
      </h3>
      {propertyLabel && (
        <p class="mt-1 text-xs font-semibold text-terracotta-strong">{propertyLabel}</p>
      )}
      {!item.priceLabel && (
        <p class="mt-1 text-sm font-semibold text-warm-gray/70">
          {item.legacyMultipleOffers
            ? "Abre el anuncio para comparar sus ofertas"
            : item.rentalMode
              ? `Modalidad por ${item.rentalMode === "monthly" ? "mes" : "día"}; precio por confirmar`
              : "Precio y modalidad por confirmar"}
        </p>
      )}
      {item.addressLabel && (
        <p class="mt-1.5 line-clamp-1 text-sm leading-5 text-warm-gray/70">
          {item.addressLabel}
        </p>
      )}
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs font-semibold text-warm-gray/70">
        {item.bedrooms != null && item.bedrooms > 0 && (
          <span>{item.bedrooms} {item.bedrooms === 1 ? "dormitorio" : "dormitorios"}</span>
        )}
        {item.beds != null && (
          <span>{item.beds} {item.beds === 1 ? "cama" : "camas"}</span>
        )}
        {item.bathrooms != null && (
          <span>{item.bathrooms} {item.bathrooms === 1 ? "baño" : "baños"}</span>
        )}
        {item.maxGuests != null && (
          <span>Capacidad: {item.maxGuests} {item.maxGuests === 1 ? "persona" : "personas"}</span>
        )}
        {item.areaLabel && <span>{item.areaLabel}</span>}
      </div>
    </div>
  </a>

  {showFavorite && item.legacyMultipleOffers && item.favoriteOffers?.length ? (
    <details class="mx-3 mb-3 rounded-xl border border-warm-gray/12 bg-cream/75 px-3 py-2">
      <summary class="cursor-pointer text-xs font-bold text-[#753a25] focus-visible:outline-2 focus-visible:outline-terracotta">
        {legacyFavoriteSummary}
      </summary>
      <ul class="mt-2 space-y-1.5 border-t border-warm-gray/10 pt-2">
        {item.favoriteOffers.map((offer, index) => (
          <li class="flex items-center justify-between gap-3">
            <span class="text-xs font-medium text-warm-gray/75">Oferta {index + 1}</span>
            <FavoriteButton
              client:visible
              roomId={offer.roomId}
              initialIsFavorite={offer.isFavorite}
              isAuthenticated={isAuthenticated}
              accessibilityContext={`oferta ${index + 1} de ${item.title}`}
              size="sm"
            />
          </li>
        ))}
      </ul>
    </details>
  ) : showFavorite && item.favoriteRoomId ? (
    <div class:list={["absolute z-10", isFeatured ? "right-3 top-3" : "right-2.5 top-2.5"]}>
      <FavoriteButton
        client:visible
        roomId={item.favoriteRoomId}
        initialIsFavorite={Boolean(item.isFavorite)}
        isAuthenticated={isAuthenticated}
        accessibilityContext={`anuncio ${item.title}`}
        size="sm"
      />
    </div>
  ) : null}
</article>
