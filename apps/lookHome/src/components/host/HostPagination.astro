---
interface Props {
  page: number;
  totalPages: number;
  basePath: string;
  queryString: string;
}

const { page, totalPages, basePath, queryString } = Astro.props;
if (totalPages <= 1) return null;
const makeHref = (targetPage: number) => {
  const params = new URLSearchParams(queryString);
  params.set("page", String(targetPage));
  return `${basePath}?${params.toString()}`;
};
---

<nav aria-label="Paginación de anuncios" class="flex items-center justify-center gap-3">
  {page > 1
    ? <a href={makeHref(page - 1)} class="inline-flex min-h-11 items-center rounded-xl border border-warm-gray/12 bg-white px-4 text-sm font-semibold text-warm-gray hover:bg-cream">Anterior</a>
    : <span aria-disabled="true" class="inline-flex min-h-11 cursor-not-allowed items-center rounded-xl bg-slate-100 px-4 text-sm font-semibold text-slate-500">Anterior</span>}
  <span class="text-sm font-semibold text-warm-gray/70">Página {page} de {totalPages}</span>
  {page < totalPages
    ? <a href={makeHref(page + 1)} class="inline-flex min-h-11 items-center rounded-xl border border-warm-gray/12 bg-white px-4 text-sm font-semibold text-warm-gray hover:bg-cream">Siguiente</a>
    : <span aria-disabled="true" class="inline-flex min-h-11 cursor-not-allowed items-center rounded-xl bg-slate-100 px-4 text-sm font-semibold text-slate-500">Siguiente</span>}
</nav>
