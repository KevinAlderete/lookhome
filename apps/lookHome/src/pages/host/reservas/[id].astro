---
import HostLayout from "@/layouts/HostLayout.astro";
import HostBookingStatusForm from "@/components/islands/host/HostBookingStatusForm";
import BookingReviewForm from "@/components/islands/bookings/BookingReviewForm";
import { formatBookingAmount, getHostBookingById } from "@/features/bookings/api/server";
import { bookingStatusMeta } from "@/features/bookings/status";
import { getMyBookingReviewStatus } from "@/features/reviews/api/server";
import type { BookingReviewStatus } from "@/features/reviews/types";

export const prerender = false;

const { id } = Astro.params;
Astro.response.headers.set("Cache-Control", "private, no-store");
const accessToken = Astro.cookies.get("lh_access_token")?.value;
let booking: any = null;
let loadError = false;
try {
  booking = await getHostBookingById(Astro.request, id!, accessToken);
} catch {
  loadError = true;
}
let reviewStatus: BookingReviewStatus | null = null;
let reviewStatusError = false;
if (
  booking &&
  ["active", "completed", "disputed"].includes(String(booking.status))
) {
  try {
    reviewStatus = await getMyBookingReviewStatus(
      Astro.request,
      booking.id,
      accessToken,
    );
  } catch {
    reviewStatusError = true;
  }
}
const statusMeta = bookingStatusMeta(String(booking?.status ?? ""));
const bookingStatus = String(booking?.status ?? "").trim().toLowerCase();
const statusDescriptions: Record<string, string> = {
  requested: "El huésped espera tu respuesta. Revisa las fechas y las condiciones antes de aprobar o rechazar la solicitud.",
  pending: "El huésped espera tu respuesta. Revisa las fechas y las condiciones antes de aprobar o rechazar la solicitud.",
  accepted: "Aprobaste esta solicitud. El huésped confirmará el inicio desde la fecha de ingreso; el pago se coordina directamente.",
  confirmed: "Esta solicitud figura como aprobada. El huésped confirmará el inicio desde la fecha de ingreso; el pago se coordina directamente.",
  rejected: "Esta solicitud fue rechazada y ya no admite una respuesta nueva.",
  cancelled: "Esta solicitud fue cancelada y ya no admite una respuesta nueva.",
  canceled: "Esta solicitud fue cancelada y ya no admite una respuesta nueva.",
  active: "La estancia está en curso.",
  completed: "Esta estancia figura como completada.",
  disputed: "Esta solicitud está en revisión.",
};
const statusDescription = statusDescriptions[bookingStatus] ?? "Revisa los datos y el estado actual de esta solicitud.";
const rentalMode = booking?.rentalMode ?? booking?.pricingSnapshot?.rentalMode;
const isMonthly = rentalMode === "monthly";
const duration = booking?.pricingSnapshot?.billingQuantity ?? booking?.termMonths;
const guestName = booking?.tenant?.profile?.displayName || "Huésped";
const currency = booking?.pricingSnapshot?.currencyCode;
const amount = (value: unknown) => formatBookingAmount(value, currency);
const formatDate = (value: unknown) => {
  if (!value) return "—";
  const date = new Date(String(value));
  if (Number.isNaN(date.getTime())) return "—";
  return date.toLocaleDateString("es-PE", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
};
const requestDate = formatDate(booking?.createdAt);
---

<HostLayout title="Solicitud de alquiler | LOOKHOME">
  <div class="mx-auto max-w-6xl space-y-6">
    <header class="space-y-4">
      <a href="/host/reservas" class="host-panel-link inline-flex min-h-11 items-center gap-2">
        <span aria-hidden="true">←</span> Volver a solicitudes
      </a>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="host-eyebrow">Espacio anfitrión · Solicitudes</p>
          <h1 class="text-3xl font-black tracking-tight text-warm-gray sm:text-4xl">Detalle de solicitud</h1>
          <p class="mt-2 max-w-2xl leading-6 text-warm-gray/70">Revisa la estancia propuesta y las condiciones antes de responder al huésped.</p>
        </div>
        {!loadError && (
          <div class="rounded-2xl border border-warm-gray/10 bg-white px-4 py-3 sm:max-w-64">
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-warm-gray/55">Solicitud recibida</p>
            <p class="mt-1 font-semibold text-warm-gray">{requestDate}</p>
          </div>
        )}
      </div>
    </header>

    {loadError || !booking ? (
      <section role="alert" class="rounded-3xl border border-red-200 bg-red-50 p-6 text-sm text-red-800">
        <h2 class="font-bold">No pudimos cargar esta solicitud</h2>
        <p class="mt-2 max-w-2xl leading-6">Puede que el enlace ya no esté disponible o que no tengas acceso a esta solicitud. Vuelve al listado para revisar tus solicitudes.</p>
        <a href="/host/reservas" class="mt-3 inline-flex min-h-11 items-center font-semibold underline">Ver solicitudes</a>
      </section>
    ) : (
      <>
        <section aria-labelledby="host-request-status" class="rounded-3xl border border-warm-gray/10 bg-white p-5 shadow-[0_18px_50px_rgba(80,76,74,0.06)] sm:p-7">
          <div class="max-w-3xl">
            <p class="host-eyebrow">Estado actual</p>
            <div class="flex flex-wrap items-center gap-3">
              <h2 id="host-request-status" class="text-2xl font-bold text-warm-gray">Seguimiento de la solicitud</h2>
              <span class={`host-status host-status--${statusMeta.tone}`}>{statusMeta.label}</span>
            </div>
            <p class="mt-2 leading-6 text-warm-gray/75">{statusDescription}</p>
          </div>
        </section>

        {(reviewStatus || reviewStatusError) && (
          <BookingReviewForm
            client:load
            bookingId={booking.id}
            revieweeName={guestName}
            publication="request"
            bookingStatus={bookingStatus}
            initialStatus={reviewStatus}
            initialStatusError={reviewStatusError}
          />
        )}

        <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.25fr)_minmax(320px,0.75fr)]">
          <section aria-labelledby="request-details-title" class="rounded-3xl border border-warm-gray/10 bg-white p-5 shadow-[0_18px_50px_rgba(80,76,74,0.06)] sm:p-7">
            <div>
              <p class="host-eyebrow">Estancia propuesta</p>
              <h2 id="request-details-title" class="text-xl font-bold text-warm-gray">{booking.room?.listing?.title || "Anuncio"}</h2>
              <p class="mt-1 text-sm text-warm-gray/70">{booking.room?.name || "Unidad no especificada"}</p>
            </div>

            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              <div class="rounded-2xl bg-cream p-4">
                <p class="text-xs font-bold uppercase tracking-[0.1em] text-warm-gray/55">{isMonthly ? "Fecha de ingreso" : rentalMode === "nightly" ? "Check-in" : "Inicio"}</p>
                <p class="mt-2 text-lg font-bold text-warm-gray">{formatDate(booking.startDate)}</p>
              </div>
              <div class="rounded-2xl bg-cream p-4">
                <p class="text-xs font-bold uppercase tracking-[0.1em] text-warm-gray/55">{isMonthly ? "Fin del plazo" : rentalMode === "nightly" ? "Check-out" : "Fin"}</p>
                <p class="mt-2 text-lg font-bold text-warm-gray">{formatDate(booking.endDate)}</p>
              </div>
            </div>

            <dl class="mt-4 grid gap-3 sm:grid-cols-2">
              <div class="rounded-2xl border border-warm-gray/10 px-4 py-3">
                <dt class="text-xs font-semibold text-warm-gray/60">Huésped</dt>
                <dd class="mt-1 font-semibold text-warm-gray">{guestName}</dd>
              </div>
              <div class="rounded-2xl border border-warm-gray/10 px-4 py-3">
                <dt class="text-xs font-semibold text-warm-gray/60">Modalidad</dt>
                <dd class="mt-1 font-semibold text-warm-gray">{isMonthly ? "Alquiler mensual" : rentalMode === "nightly" ? "Estancia por noche" : "No especificada"}</dd>
              </div>
              <div class="rounded-2xl border border-warm-gray/10 px-4 py-3">
                <dt class="text-xs font-semibold text-warm-gray/60">Duración</dt>
                <dd class="mt-1 font-semibold text-warm-gray">{duration && rentalMode ? `${duration} ${isMonthly ? "meses" : "noches"}` : "—"}</dd>
              </div>
              {rentalMode === "nightly" && (
                <div class="rounded-2xl border border-warm-gray/10 px-4 py-3">
                  <dt class="text-xs font-semibold text-warm-gray/60">Huéspedes</dt>
                  <dd class="mt-1 font-semibold text-warm-gray">{booking.guestCount ?? "—"}</dd>
                </div>
              )}
            </dl>

            <div class="mt-5 rounded-2xl border border-warm-gray/10 px-4 py-4">
              <p class="text-xs font-bold uppercase tracking-[0.1em] text-warm-gray/55">Mensaje del huésped</p>
              <p class="mt-2 whitespace-pre-wrap break-words leading-6 text-warm-gray">{booking.message || "El huésped no agregó un mensaje."}</p>
            </div>
          </section>

          <aside class="space-y-5 xl:sticky xl:top-6">
            <section aria-labelledby="host-estimate-title" class="rounded-3xl border border-warm-gray/10 bg-white p-5 shadow-[0_18px_50px_rgba(80,76,74,0.06)] sm:p-6">
              <p class="host-eyebrow">Condiciones estimadas</p>
              <h2 id="host-estimate-title" class="text-xl font-bold text-warm-gray">Resumen del alquiler</h2>
              <dl class="mt-5 space-y-4">
                <div class="flex items-start justify-between gap-4">
                  <dt class="text-sm text-warm-gray/70">Tarifa {isMonthly ? "por mes" : rentalMode === "nightly" ? "por noche" : "por período"}</dt>
                  <dd class="text-right text-sm font-semibold text-warm-gray">{amount(booking.pricingSnapshot?.rentAmount)}</dd>
                </div>
                {duration && (
                  <div class="flex items-start justify-between gap-4">
                    <dt class="text-sm text-warm-gray/70">Duración</dt>
                    <dd class="text-right text-sm font-semibold text-warm-gray">{duration} {isMonthly ? "meses" : "noches"}</dd>
                  </div>
                )}
                {isMonthly && booking.pricingSnapshot?.depositAmount != null && (
                  <div class="flex items-start justify-between gap-4">
                    <dt class="max-w-40 text-sm text-warm-gray/70">Depósito, incluido en la estimación</dt>
                    <dd class="text-right text-sm font-semibold text-warm-gray">{amount(booking.pricingSnapshot.depositAmount)}</dd>
                  </div>
                )}
                {rentalMode === "nightly" && booking.pricingSnapshot?.cleaningFee != null && (
                  <div class="flex items-start justify-between gap-4">
                    <dt class="max-w-40 text-sm text-warm-gray/70">Limpieza, incluida en la estimación</dt>
                    <dd class="text-right text-sm font-semibold text-warm-gray">{amount(booking.pricingSnapshot.cleaningFee)}</dd>
                  </div>
                )}
                <div class="border-t border-warm-gray/10 pt-4">
                  <dt class="text-sm font-semibold text-warm-gray">Total estimado del alquiler</dt>
                  <dd class="mt-1 text-2xl font-bold tracking-tight text-warm-gray">{amount(booking.pricingSnapshot?.totalAmount)}</dd>
                </div>
              </dl>
              <p class="mt-4 rounded-2xl bg-cream px-4 py-3 text-sm leading-5 text-warm-gray/75">
                La estimación conserva las condiciones enviadas. LOOKHOME no procesa pagos; huésped y anfitrión coordinan el pago directamente.
              </p>
            </section>

            <HostBookingStatusForm
              client:load
              bookingId={booking.id}
              currentStatus={booking.status}
            />
          </aside>
        </div>
      </>
    )}
  </div>
</HostLayout>
