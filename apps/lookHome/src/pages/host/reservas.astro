---
import HostLayout from "@/layouts/HostLayout.astro";
import BookingsTable from "@/components/islands/tables/BookingsTable";
import { getHostBookings } from "@/features/bookings/api/server";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
let rows: Awaited<ReturnType<typeof getHostBookings>> = [];
let loadError = false;
try {
  rows = await getHostBookings(Astro.request, Astro.cookies.get("lh_access_token")?.value);
} catch {
  loadError = true;
}
---

<HostLayout title="Reservas | LOOKHOME">
  <div class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="host-eyebrow">Actividad de alojamientos</p>
        <h1 class="text-4xl font-black text-warm-gray">Solicitudes de alquiler</h1>
        <p class="mt-2 max-w-2xl text-warm-gray/70">
          Revisa las solicitudes por modalidad y fechas. El huésped verá si apruebas o rechazas su solicitud.
        </p>
      </div>
      <a href="/host/reservas" class="inline-flex min-h-11 items-center rounded-xl border border-warm-gray/15 bg-white px-4 text-sm font-semibold text-warm-gray hover:bg-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">
        Actualizar solicitudes
      </a>
    </div>

    {loadError ? (
      <section role="alert" class="rounded-2xl border border-red-200 bg-red-50 p-5 text-sm text-red-800">
        <h2 class="font-bold">No pudimos cargar las solicitudes</h2>
        <p class="mt-2">Comprueba tu conexión y vuelve a intentarlo. No se mostrará una lista vacía mientras falle la carga.</p>
        <a href="/host/reservas" class="mt-3 inline-flex min-h-11 items-center font-semibold underline focus-visible:outline-2 focus-visible:outline-offset-2">Reintentar</a>
      </section>
    ) : (
      <BookingsTable client:load rows={rows} detailBase="/host/reservas" emptyText="Aún no recibiste solicitudes de alquiler para tus anuncios." />
    )}
  </div>
</HostLayout>
