---
import PropertyCard from "@/components/astro/PropertyCard.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
import { getPublicHostProfile } from "@/features/profile/api/server";

export const prerender = false;

const hostUserId = Astro.params.hostUserId ?? "";
const requestedPage = Number(Astro.url.searchParams.get("page"));
const page = Number.isInteger(requestedPage) && requestedPage > 0
  ? requestedPage
  : 1;
let profile = null;
let items = [];
let total = 0;
let pageSize = 12;
let hasError = false;

try {
  const result = await getPublicHostProfile(Astro.request, hostUserId, page);
  profile = result.profile;
  items = result.items;
  total = result.total;
  pageSize = result.pageSize;
} catch (error) {
  hasError = true;
  console.error("Public host profile could not be loaded", error);
}

const totalPages = Math.max(1, Math.ceil(total / pageSize));
if (!hasError && total > 0 && page > totalPages) {
  return Astro.redirect(`/anfitriones/${encodeURIComponent(hostUserId)}?page=${totalPages}`);
}
const pageHref = (nextPage: number) =>
  `/anfitriones/${encodeURIComponent(hostUserId)}?page=${nextPage}`;
---

<PublicLayout
  title={`${profile?.displayName ?? "Perfil de anfitrión"} | LOOKHOME`}
  description="Conoce el perfil público y los anuncios publicados de este anfitrión en LOOKHOME."
>
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    {hasError || !profile ? (
      <div class="mx-auto max-w-2xl rounded-3xl border border-warm-gray/10 bg-white px-6 py-12 text-center shadow-sm">
        <p class="text-sm font-semibold text-terracotta-strong">LOOKHOME</p>
        <h1 class="mt-2 text-3xl font-bold text-warm-gray">
          No encontramos este perfil público
        </h1>
        <p class="mt-3 text-sm leading-6 text-warm-gray/70">
          Puede que el anfitrión ya no tenga anuncios publicados. Explora otros alojamientos disponibles.
        </p>
        <a
          href="/buscar"
          class="mt-6 inline-flex min-h-11 items-center rounded-xl bg-terracotta-strong px-5 font-semibold text-white transition hover:bg-warm-gray focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta"
        >
          Buscar anuncios
        </a>
      </div>
    ) : (
      <>
        <header class="flex flex-col gap-5 rounded-3xl border border-warm-gray/10 bg-white p-6 shadow-[0_14px_40px_rgba(80,76,74,0.08)] sm:flex-row sm:items-center sm:p-8">
          <img
            src={profile.photoUrl || "/avatar-placeholder.png"}
            alt=""
            width="112"
            height="112"
            class="h-24 w-24 shrink-0 rounded-full border-4 border-cream object-cover sm:h-28 sm:w-28"
          />
          <div class="min-w-0">
            <p class="text-sm font-semibold text-terracotta-strong">Anfitrión</p>
            <h1 class="mt-1 break-words text-3xl font-bold text-warm-gray sm:text-4xl">
              {profile.displayName}
            </h1>
            <p class="mt-2 text-sm text-warm-gray/70">
              {total} {total === 1 ? "anuncio publicado" : "anuncios publicados"}
            </p>
          </div>
        </header>

        <section class="mt-8" aria-labelledby="host-listings-title">
          <div class="flex flex-wrap items-end justify-between gap-3 border-b border-warm-gray/10 pb-4">
            <div>
              <p class="text-sm font-semibold text-terracotta-strong">Disponibles en LOOKHOME</p>
              <h2 id="host-listings-title" class="mt-1 text-2xl font-bold text-warm-gray">
                Anuncios de {profile.displayName}
              </h2>
            </div>
            <a href="/buscar" class="text-sm font-semibold text-terracotta-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-terracotta-strong">
              Ver todos los anuncios
            </a>
          </div>

          {items.length === 0 ? (
            <p class="mt-5 rounded-2xl border border-dashed border-warm-gray/20 bg-white p-6 text-sm text-warm-gray/70">
              Este anfitrión no tiene anuncios publicados en este momento.
            </p>
          ) : (
            <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((item, index) => (
                <PropertyCard
                  item={item}
                  showFavorite={false}
                  priority={index === 0}
                  returnTo={pageHref(page)}
                />
              ))}
            </div>
          )}

          {totalPages > 1 && (
            <nav class="mt-7 flex items-center justify-between gap-3" aria-label="Paginación de anuncios del anfitrión">
              {page > 1 ? (
                <a href={pageHref(page - 1)} rel="prev" class="inline-flex min-h-11 items-center rounded-xl border border-warm-gray/20 px-4 text-sm font-semibold hover:border-terracotta focus-visible:outline-2 focus-visible:outline-terracotta">
                  Anterior
                </a>
              ) : <span />}
              <span class="text-sm font-semibold text-warm-gray/70">Página {page} de {totalPages}</span>
              {page < totalPages ? (
                <a href={pageHref(page + 1)} rel="next" class="inline-flex min-h-11 items-center rounded-xl border border-warm-gray/20 px-4 text-sm font-semibold hover:border-terracotta focus-visible:outline-2 focus-visible:outline-terracotta">
                  Siguiente
                </a>
              ) : <span />}
            </nav>
          )}
        </section>
      </>
    )}
  </section>
</PublicLayout>
