---
import AppLayout from "@/layouts/AppLayout.astro";
import { getMyBookings } from "@/features/bookings/api/server";
import { bookingStatusMeta } from "@/features/bookings/status";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store");

let rows: Awaited<ReturnType<typeof getMyBookings>> = [];
let loadError = false;
try {
  rows = await getMyBookings(Astro.request, Astro.cookies.get("lh_access_token")?.value);
} catch {
  loadError = true;
}

const tabs = [
  { key: "todas", label: "Todas" },
  { key: "pendientes", label: "Pendientes" },
  { key: "aprobadas", label: "Aprobadas" },
  { key: "encurso", label: "En curso" },
  { key: "completadas", label: "Completadas" },
  { key: "cerradas", label: "Cerradas" },
  { key: "revision", label: "En revisión" },
] as const;
const selected = tabs.find((tab) => tab.key === Astro.url.searchParams.get("estado"))?.key ?? "todas";
const filtered = rows.filter((row) => {
  const status = row.status.toLowerCase();
  if (selected === "pendientes") return ["requested", "pending"].includes(status);
  if (selected === "aprobadas") return ["accepted", "confirmed"].includes(status);
  if (selected === "encurso") return status === "active";
  if (selected === "completadas") return status === "completed";
  if (selected === "cerradas") return ["rejected", "cancelled", "canceled", "paid", "refunded"].includes(status);
  if (selected === "revision") return status === "disputed";
  return true;
});
---

<AppLayout title="Mis solicitudes de alquiler | LOOKHOME">
  <div class="mx-auto max-w-5xl space-y-7 pb-12">
    <header>
      <p class="text-sm font-semibold text-terracotta-strong">Tu cuenta</p>
      <h1 class="mt-1 text-3xl font-bold text-warm-gray sm:text-4xl">Mis solicitudes de alquiler</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-warm-gray/75">
        Consulta el estado de las ofertas que solicitaste. El anfitrión debe aprobar cada solicitud; enviarla no confirma la reserva.
      </p>
    </header>

    {loadError ? (
      <section role="alert" class="rounded-3xl border border-red-200 bg-red-50 p-6 text-sm text-red-800">
        <h2 class="font-bold">No pudimos cargar tus solicitudes</h2>
        <p class="mt-2">Comprueba tu conexión e inténtalo de nuevo.</p>
        <a href="/reservas" class="mt-3 inline-flex min-h-11 items-center font-semibold underline focus-visible:outline-2 focus-visible:outline-offset-2">Reintentar</a>
      </section>
    ) : (
      <>
        <nav aria-label="Filtrar mis solicitudes" class="flex gap-2 overflow-x-auto border-b border-warm-gray/15 pb-2">
          {tabs.map((tab) => (
            <a href={tab.key === "todas" ? "/reservas" : `/reservas?estado=${tab.key}`} aria-current={selected === tab.key ? "page" : undefined} class={`inline-flex min-h-11 shrink-0 items-center rounded-xl px-4 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong ${selected === tab.key ? "bg-terracotta-strong text-white" : "text-warm-gray hover:bg-white"}`}>
              {tab.label}
            </a>
          ))}
        </nav>
        {filtered.length ? (
          <section aria-label="Solicitudes enviadas" class="space-y-4">
            <p class="text-sm text-warm-gray/75">{filtered.length} {filtered.length === 1 ? "solicitud" : "solicitudes"}</p>
            {filtered.map((row) => {
              const status = bookingStatusMeta(row.status);
              const isCompleted = row.status.trim().toLowerCase() === "completed";
              return (
                <article class="rounded-3xl border border-warm-gray/10 bg-white p-5 shadow-[0_12px_36px_rgba(80,76,74,0.07)] sm:p-6">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-xs font-semibold text-terracotta-strong">{row.rentalMode === "monthly" ? "Alquiler mensual" : row.rentalMode === "nightly" ? "Alquiler por noche" : "Modalidad por confirmar"}</p>
                      <h2 class="mt-1 break-words text-xl font-bold text-warm-gray">{row.propertyTitle}</h2>
                      <p class="mt-1 text-sm text-warm-gray/75">Anfitrión: {row.hostName}</p>
                    </div>
                    <span class={`inline-flex rounded-full border px-3 py-1 text-sm font-semibold ${status.tone === "positive" ? "border-green-200 bg-green-50 text-green-800" : status.tone === "warning" ? "border-amber-200 bg-amber-50 text-amber-900" : status.tone === "danger" ? "border-red-200 bg-red-50 text-red-800" : "border-warm-gray/15 bg-cream text-warm-gray"}`}>{status.label}</span>
                  </div>
                  <dl class="mt-5 grid gap-4 border-t border-warm-gray/10 pt-4 text-sm sm:grid-cols-3">
                    <div><dt class="text-warm-gray/75">{row.rentalMode === "monthly" ? "Ingreso" : "Check-in"}</dt><dd class="mt-1 font-semibold text-warm-gray">{row.checkIn}</dd></div>
                    <div><dt class="text-warm-gray/75">{row.rentalMode === "monthly" ? "Fin del plazo" : "Check-out"}</dt><dd class="mt-1 font-semibold text-warm-gray">{row.checkOut}</dd></div>
                    <div><dt class="text-warm-gray/75">Estimación total del alquiler</dt><dd class="mt-1 font-semibold text-warm-gray">{row.estimatedAmount}</dd></div>
                  </dl>
                  <p class="mt-3 text-sm text-warm-gray/75">{[row.rentAmount, row.durationLabel, row.rentalMode === "nightly" ? `${row.guests} ${row.guests === 1 ? "huésped" : "huéspedes"}` : null].filter(Boolean).join(" · ")}</p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    <a href={`/reservas/${encodeURIComponent(row.id)}`} class="inline-flex min-h-11 items-center rounded-xl border border-terracotta-strong px-4 text-sm font-semibold text-terracotta-strong hover:bg-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">Ver detalle de la solicitud</a>
                    {isCompleted && <a href={`/reservas/${encodeURIComponent(row.id)}#booking-review`} class="inline-flex min-h-11 items-center rounded-xl bg-terracotta-strong px-4 text-sm font-semibold text-white hover:bg-warm-gray focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">Ver o dejar reseña</a>}
                  </div>
                </article>
              );
            })}
          </section>
        ) : (
          <section class="rounded-3xl border border-warm-gray/10 bg-white p-8 text-center shadow-[0_12px_36px_rgba(80,76,74,0.07)]">
            <h2 class="text-xl font-bold text-warm-gray">{rows.length ? "No hay solicitudes en este estado" : "Aún no has enviado solicitudes"}</h2>
            <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-warm-gray/75">{rows.length ? "Prueba otra categoría para ver tus solicitudes." : "Busca una oferta que se ajuste a lo que necesitas y envía tu solicitud al anfitrión."}</p>
            <a href={rows.length ? "/reservas" : "/buscar"} class="mt-5 inline-flex min-h-11 items-center rounded-xl bg-terracotta-strong px-5 text-sm font-semibold text-white hover:bg-warm-gray focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta-strong">{rows.length ? "Ver todas" : "Explorar anuncios"}</a>
          </section>
        )}
      </>
    )}
  </div>
</AppLayout>
