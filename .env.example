# Shared
NODE_ENV=development

# Web
APP_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:3000/api

# API
PORT=3000
# Neon pooled connection string, with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=LOOKHOME <no-reply@example.com>
API_PUBLIC_URL=http://localhost:3000
# Server-only key used for host address search and reverse geocoding.
MAPTILER_GEOCODING_KEY=replace-with-your-maptiler-key
# Local development/fallback only; production Render uses B2.
UPLOAD_ROOT=./uploads
# Local development/fallback only; must be outside UPLOAD_ROOT.
PRIVATE_UPLOAD_ROOT=./private-uploads
# Use local for development and b2 for the Render production service.
MEDIA_STORAGE_PROVIDER=local
# Backblaze B2 S3 endpoint and region from the bucket details.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
# Create this as an all-private bucket and replace the example name.
B2_BUCKET=lookhome-yourname-media
# Bucket-restricted B2 application key; keep it server-only.
B2_ACCESS_KEY_ID=replace-with-b2-key-id
B2_SECRET_ACCESS_KEY=replace-with-b2-application-key
# Maximum stored image variants per user (default: 2 GiB).
MEDIA_MAX_STORAGE_BYTES_PER_USER=2147483648
MEDIA_CLEANUP_INTERVAL_MS=900000
